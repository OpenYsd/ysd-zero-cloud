# YSD Zero Cloud environment.
#
# Copy to `.env.local` for local development, or set each value as a Worker
# secret (`wrangler secret put NAME`) for a deployment. Never commit real
# values: `.env*` is ignored apart from this example.
#
# Only BETTER_AUTH_SECRET is required, and only outside development. Every
# other entry unlocks an optional integration; the app runs without them and
# reports each one as "Not configured" in Settings.

# --- Required outside development ---------------------------------------
# Signing key for Better Auth sessions, and the default master key for secret
# encryption. Generate with: openssl rand -base64 32
# In development the app falls back to a published constant and refuses to do
# so anywhere else.
BETTER_AUTH_SECRET=

# --- Optional: identity -------------------------------------------------
# Absolute origin Better Auth issues OAuth callbacks against. Inferred from
# the request when unset, which is correct for most deployments.
BETTER_AUTH_URL=

# GitHub OAuth sign-in. Both are required for the provider to be offered.
# Create at https://github.com/settings/developers with the callback URL
# <your-origin>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional: secret encryption ----------------------------------------
# Dedicated master key for stored secrets. Falls back to BETTER_AUTH_SECRET.
# Set this separately if you want to rotate session signing without having to
# re-enter every stored secret.
YSD_SECRETS_KEY=

# --- Optional: instance ownership ---------------------------------------
# The operator allowed to use the SQL Editor. A raw statement cannot be scoped
# to a single workspace, so the editor is limited to one trusted account while
# Database Studio stays open to everyone with their own rows.
# Defaults to the first registered account; set this so ownership does not
# depend on who happened to sign up first.
YSD_OWNER_EMAIL=

# --- Optional: abuse protection -----------------------------------------
# Cloudflare Turnstile. Free on every plan. Create a widget at
# dash.cloudflare.com > Turnstile. Both keys are required: with either missing
# the challenge is skipped entirely and YSD Shield raises it as a finding,
# rather than silently pretending to be on.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: transactional email --------------------------------------
# Enables email verification. Resend's free tier is the supported provider.
# Verification is only *required* when a provider is configured — requiring a
# verified address with no way to deliver the link would lock every operator
# out of their own instance.
RESEND_API_KEY=
YSD_EMAIL_FROM=
# Set to "false" to keep verification optional even with mail configured.
YSD_REQUIRE_EMAIL_VERIFICATION=

# --- Optional: Smart Deploy repository inspection -----------------------
# Read-only token. Without it, public repositories are still inspected
# anonymously (subject to GitHub's unauthenticated rate limit) and private
# ones fall back to name-based framework inference.
GITHUB_TOKEN=

# --- Optional: Cloudflare account reads ---------------------------------
# Used only to report the D1 database size, which a Worker cannot measure
# from inside itself. Read-only scopes are enough.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=

# --- Optional: Supabase adapter -----------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public metadata ----------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Local development only ---------------------------------------------
# Where Miniflare stores its simulated D1 database. Set this to a short path
# (for example C:/ysd-state) if you are on Windows and the checkout is deep
# enough that the state path crosses the 260-character limit; SQLite reports
# that failure only as an opaque internal error.
YSD_LOCAL_STATE_PATH=
